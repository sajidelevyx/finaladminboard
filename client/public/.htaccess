DirectoryIndex index.php index.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE application/x-font-ttf
  AddOutputFilterByType DEFLATE font/opentype
</IfModule>

<IfModule mod_headers.c>
  # Disable caching for index.html so users always receive latest bundle
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>

  # Cache static hashed assets (JS, CSS, images) for 1 year
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Pass through existing files and directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # AI Engine Endpoints
  RewriteRule ^api/ai/enhance/?$ api_ai_enhancer.php [L,QSA]
  RewriteRule ^dashboard/api/ai/enhance/?$ api_ai_enhancer.php [L,QSA]
  RewriteRule ^admin/api/ai/enhance/?$ api_ai_enhancer.php [L,QSA]

  RewriteRule ^api/ai/copy/?$ api_ai_copywriter.php [L,QSA]
  RewriteRule ^dashboard/api/ai/copy/?$ api_ai_copywriter.php [L,QSA]
  RewriteRule ^admin/api/ai/copy/?$ api_ai_copywriter.php [L,QSA]

  # Document OCR Endpoints
  RewriteRule ^api/listings/parse-documents/?$ api/parse-documents.php [L,QSA]
  RewriteRule ^api/parse-documents/?$ api/parse-documents.php [L,QSA]
  RewriteRule ^dashboard/api/listings/parse-documents/?$ api/parse-documents.php [L,QSA]
  RewriteRule ^dashboard/api/parse-documents/?$ api/parse-documents.php [L,QSA]
  RewriteRule ^admin/api/parse-documents/?$ api/parse-documents.php [L,QSA]

  # Marketing Copy Endpoints
  RewriteRule ^api/listings/[^/]+/generate-copy/?$ api/generate-copy.php [L,QSA]
  RewriteRule ^api/generate-copy/?$ api/generate-copy.php [L,QSA]
  RewriteRule ^dashboard/api/listings/[^/]+/generate-copy/?$ api/generate-copy.php [L,QSA]
  RewriteRule ^dashboard/api/generate-copy/?$ api/generate-copy.php [L,QSA]
  RewriteRule ^admin/api/generate-copy/?$ api/generate-copy.php [L,QSA]

  # Bitrix CRM Endpoints
  RewriteRule ^api/push-listing-bitrix/?$ api/push-listing-bitrix.php [L,QSA]
  RewriteRule ^dashboard/api/push-listing-bitrix/?$ api/push-listing-bitrix.php [L,QSA]
  RewriteRule ^api/push-to-bitrix/?$ api/push-to-bitrix.php [L,QSA]
  RewriteRule ^dashboard/api/push-to-bitrix/?$ api/push-to-bitrix.php [L,QSA]

  # Clean Single Page Application (SPA) routing fallback
  RewriteRule ^(overview|leads|datacleaning|listing|new|detail|owners|buildings|voice|voiceagent|agent|search|team|roles|settings|workflows)/?$ index.html [L,QSA]
  RewriteRule ^ index.html [L]
</IfModule>

# Fallback 404 handler
ErrorDocument 404 index.html
